[Desktop Entry]
Name=@name@
GenericName=Greeter & @name@
Type=Application
Exec=@exec@
Terminal=false
Categories=GNOME;GTK;Documentation;Utility;
Keywords=Gnome;GTK;
# Translators: Do NOT translate or transliterate this text (this is an icon file name)!
Icon=@icon@
DBusActivatable=true
StartupNotify=true
OnlyShowIn=GNOME;
